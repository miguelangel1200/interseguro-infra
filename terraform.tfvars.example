# Copia este archivo a terraform.tfvars y completa los valores.
# NUNCA subas terraform.tfvars a un repositorio.

project_id     = "interseguros-prueba"
region         = "us-central1"

auth_user      = "admin"
# AUTH_PASSWORD debe contener un hash bcrypt (p. ej. generado con bcryptjs),
# nunca la contraseña en texto plano. El de abajo es el hash de "password123".
auth_password  = "$2b$10$TUTDxxdMlDFF/RWFarXTcuMceWFdtpIMvdwt3FNhJGopg0QZXC.Tu"

jwt_secret     = "cambia-este-secreto-por-uno-seguro"
jwt_issuer     = "interseguro"
jwt_audience   = "interseguro-api"
jwt_expires_in = "2h"

cors_origin    = "https://interseguro-frontend.pages.dev"