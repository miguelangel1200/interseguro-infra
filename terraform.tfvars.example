# Copia este archivo a terraform.tfvars y completa los valores.
# NUNCA subas terraform.tfvars a un repositorio.

project_id     = "interseguros-prueba"
region         = "us-central1"

auth_user      = "admin"
# AUTH_PASSWORD debe contener un hash bcrypt (generado con bcryptjs), nunca la
# contraseña en texto plano. Genera el tuyo:
#   node -e "console.log(require('bcryptjs').hashSync(process.env.AUTH_PASSWORD, 10))"
# (la credencial de acceso se entrega por correo)
auth_password  = "reemplaza-por-hash-bcrypt"

jwt_secret     = "cambia-este-secreto-por-uno-seguro"
jwt_issuer     = "interseguro"
jwt_audience   = "interseguro-api"
jwt_expires_in = "2h"

cors_origin    = "https://interseguro-frontend.pages.dev"